# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA suba o arquivo .env para o Git

# ── Telegram ────────────────────────────────────────────────────────
API_ID=seu_api_id_aqui
API_HASH=seu_api_hash_aqui
PHONE=+55119XXXXXXXX
SESSION_STRING=sua_session_string_aqui
TELEGRAM_PASSWORD=sua_senha_2fa_se_tiver
TELEGRAM_SIGNAL_GROUPS=-1001234567890,-1009876543210

# ── Autenticação da API ─────────────────────────────────────────────
API_KEY=seu_token_secreto_aqui

# ── WhatsApp (Evolution API) ────────────────────────────────────────
EVOLUTION_URL=https://sua-evolution-api.up.railway.app
EVOLUTION_TOKEN=sua_apikey_evolution_aqui
EVOLUTION_INSTANCE=NomeDaSuaInstancia
WHATSAPP_NUMBER=5511999999999
